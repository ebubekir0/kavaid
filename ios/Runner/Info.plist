<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>tr</string>
		<string>en</string>
		<string>ar</string>
		<string>id</string>
		<string>ms</string>
		<string>ur</string>
		<string>fr</string>
		<string>bn</string>
		<string>ru</string>
		<string>uz</string>
		<string>az</string>
		<string>de</string>
	</array>
	<key>CFBundleDisplayName</key>
	<string>Kavaid</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>kavaid</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!-- App Store şifreleme beyanı -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- Profil resmi için fotoğraf ve kamera erişimi -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Photo access is needed to choose your profile photo.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Photo access is needed to choose your profile photo.</string>
	<key>NSCameraUsageDescription</key>
	<string>Camera access is needed to take your profile photo.</string>
	
	<!-- Konum İzni -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Location is used to apply the right regional settings for in-app services.</string>
	
	<!-- App Store İnceleme Notları -->
	<key>NSInAppPurchaseUsageDescription</key>
	<string>Bu uygulama, reklamları kaldırma ve kitap satın alma özelliklerini sunar.</string>
	
	<!-- Mikrofon izni (TTS ve Sesli Arama için) -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Microphone access is needed to search for words by voice.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Speech recognition is needed to turn your voice searches into text.</string>
	
	<!-- Network Usage (Firebase için) -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
	</dict>
</dict>
</plist>
